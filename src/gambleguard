#!/bin/bash
# gambleguard - re-applies the gambling block and the browser policies that keep it honest.
# launchd runs this on an interval; that is what makes it self-healing.
MARK_A="# >>> gamble-guard >>>"
MARK_B="# <<< gamble-guard <<<"
LIST="${LIST:-/usr/local/share/gambleguard/blocklist.txt}"
HOSTS="${HOSTS:-/etc/hosts}"       # overridable so the logic can be tested off a real system

# --- 0. weekly list refresh --------------------------------------------------
# A GitHub Action rebuilds lists/ every Monday from four upstream blocklists; pull it so
# newly discovered casinos get blocked without anyone shipping a release.
LIST_URL="${LIST_URL:-https://raw.githubusercontent.com/prime-server/gamble-guard/main/lists/full.txt}"
STAMP="${STAMP:-/usr/local/share/gambleguard/.refreshed}"
if [ "${SKIP_REFRESH:-}" != 1 ] && { [ ! -f "$STAMP" ] || [ -n "$(find "$STAMP" -mtime +6 2>/dev/null)" ]; }; then
  NEW=$(mktemp)
  # a bad download must never replace a good list: require a plausible size
  if curl -fsSL --max-time 300 "$LIST_URL" -o "$NEW" && [ "$(grep -c '^0\.0\.0\.0 ' "$NEW")" -ge 100000 ]; then
    chflags noschg "$LIST" 2>/dev/null || true
    install -m 644 "$NEW" "$LIST" && chflags schg "$LIST" 2>/dev/null
    touch "$STAMP"
    logger -t gambleguard "refreshed blocklist: $(wc -l < "$LIST" | tr -d ' ') entries"
  fi
  rm -f "$NEW"
fi

# --- 1. the hosts block ---------------------------------------------------
if [ -r "$LIST" ]; then
  TMP=$(mktemp) || exit 0
  trap 'rm -f "$TMP"' EXIT
  sed "/^${MARK_A}\$/,/^${MARK_B}\$/d" "$HOSTS" > "$TMP"   # keep everything else in the file
  printf '%s\n' "$MARK_A" >> "$TMP"
  cat "$LIST" >> "$TMP"
  printf '%s\n' "$MARK_B" >> "$TMP"
  if ! cmp -s "$TMP" "$HOSTS"; then
    chflags noschg "$HOSTS" 2>/dev/null || true
    cat "$TMP" > "$HOSTS"
    chmod 644 "$HOSTS" 2>/dev/null || true
    dscacheutil -flushcache 2>/dev/null || true
    killall -HUP mDNSResponder 2>/dev/null || true
    logger -t gambleguard "restored gambling block"
  fi
fi

# --- 2. upstream filtering resolver ----------------------------------------
# A hosts file has no wildcards, so a brand-new mirror is open until the list catches
# up. Pointing the OS resolver at Mullvad's free family DNS (filters gambling, no
# account) closes that gap: with browser DoH forced off below, every lookup goes
# hosts file first, then this. iCloud Private Relay must be off or Safari skips both.
#
# Never replace a resolver that is already blocking. A lapsed paid blocker often leaves
# its filtering servers behind; swapping them out would trade one protection for another
# at best. Existing servers are probed and kept in front of Mullvad if they still filter.
DNS="194.242.2.6 2a07:e340::6"
PROBE="${DNS_PROBE:-dig +short +time=3 +tries=1}"
blocks(){  # $1 = server: refuses or blanks a gambling domain while resolving a control domain
  local g c
  g=$($PROBE @"$1" bet365.com A 2>/dev/null | head -1)
  c=$($PROBE @"$1" github.com A 2>/dev/null | head -1)
  [ -n "$c" ] && { [ -z "$g" ] || [ "$g" = "0.0.0.0" ]; }
}
if [ "${SKIP_DNS:-}" != 1 ]; then
  # skip disabled (*) services, Thunderbolt Bridge (never carries DNS) and Tailscale,
  # whose entry tailscaled owns for MagicDNS - overriding it breaks tailnet lookups
  networksetup -listallnetworkservices 2>/dev/null \
    | grep -v -e '^An asterisk' -e '^\*' -e '^Thunderbolt Bridge$' -e '^Tailscale$' \
    | while IFS= read -r S; do
      CUR=$(networksetup -getdnsservers "$S" 2>/dev/null | grep -E '^[0-9a-fA-F.:]+$' | paste -sd' ' -)
      KEEP=""
      for ip in $CUR; do
        case " $DNS " in *" $ip "*) continue;; esac
        blocks "$ip" && KEEP="$KEEP $ip"
      done
      WANT=$(echo $KEEP $DNS)                     # existing filters first, then Mullvad
      [ "$CUR" = "$WANT" ] && continue            # already right, no churn
      # $WANT unquoted on purpose: one argument per server
      networksetup -setdnsservers "$S" $WANT 2>/dev/null && logger -t gambleguard "set upstream resolver on $S: $WANT"
    done
fi
# --- 3. browser DNS ------------------------------------------------------
# A browser doing DNS-over-HTTPS resolves names itself and never reads the hosts
# file, which silently defeats everything above. Safari uses the system resolver,
# so it needs nothing here; Chrome and Firefox both need DoH forced off. Keeping DoH
# off is also what routes them through the upstream resolver above.
[ "${SKIP_BROWSERS:-}" = 1 ] && exit 0

CHROME=/Library/Preferences/com.google.Chrome
if [ -d "/Applications/Google Chrome.app" ] || [ -f "$CHROME.plist" ]; then
  defaults write "$CHROME" DnsOverHttpsMode -string "off"
  defaults write "$CHROME" BuiltInDnsClientEnabled -bool false
  # a stale template keeps pointing Chrome at a third-party resolver
  defaults delete "$CHROME" DnsOverHttpsTemplates 2>/dev/null || true
fi

FIREFOX=/Library/Preferences/org.mozilla.firefox
defaults write "$FIREFOX" EnterprisePoliciesEnabled -bool true
defaults write "$FIREFOX" DNSOverHTTPS -dict Enabled -bool false Locked -bool true
defaults write "$FIREFOX" "Preferences__network.trr.mode__Value" -int 5     # 5 = DoH off
defaults write "$FIREFOX" "Preferences__network.trr.mode__Status" -string locked
defaults write "$FIREFOX" "Preferences__network.trr.uri__Value" -string ""
defaults write "$FIREFOX" "Preferences__network.trr.uri__Status" -string locked

# --- 4. keep the peer watchdog alive (it does the same for this script) ---
PRISTINE=/usr/local/share/gambleguard/pristine
if [ -d "$PRISTINE" ]; then
  [ -x /usr/local/bin/gambleguard-watch ] || { install -m 755 "$PRISTINE/gambleguard-watch" /usr/local/bin/gambleguard-watch 2>/dev/null && chflags schg /usr/local/bin/gambleguard-watch 2>/dev/null; }
  [ -f /Library/LaunchDaemons/com.gambleguard.watch.plist ] || { install -m 644 -o root -g wheel "$PRISTINE/com.gambleguard.watch.plist" /Library/LaunchDaemons/com.gambleguard.watch.plist 2>/dev/null && chflags schg /Library/LaunchDaemons/com.gambleguard.watch.plist 2>/dev/null; }
  launchctl print system/com.gambleguard.watch >/dev/null 2>&1 || launchctl bootstrap system /Library/LaunchDaemons/com.gambleguard.watch.plist 2>/dev/null || true
fi

FFDIST="/Applications/Firefox.app/Contents/Resources/distribution"
if [ -d "/Applications/Firefox.app" ]; then
  mkdir -p "$FFDIST"
  printf '%s\n' '{"policies":{"DNSOverHTTPS":{"Enabled":false,"Locked":true}}}' > "$FFDIST/policies.json"
fi
exit 0
